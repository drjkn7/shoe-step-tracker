    <!-- Health Connect privacy rationale -->
    <string name="rationale_title">Why we read your activity</string>
    <string name="rationale_what">Shoe Step Tracker reads only two things from Health Connect: your step count and the distance you walked. It never reads other health data and never writes anything to Health Connect.</string>
    <string name="rationale_why">It uses the steps and distance from while a session is running to show how far each pair of shoes has walked and what each pair costs per step and per km or mile.</string>
    <string name="rationale_stays">This data stays on this phone. The app has no internet access, no accounts and no ads, and it doesn\'t share your data with anyone.</string>
    <string name="rationale_control">You can stop this at any time in Health Connect. Sessions are still saved, but their steps or distance won\'t be counted.</string>
    <string name="rationale_close">Close</string>
