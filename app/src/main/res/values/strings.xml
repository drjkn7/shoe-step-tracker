    <!-- Health Connect privacy rationale -->
    <string name="rationale_title">Why we read your steps</string>
    <string name="rationale_what">Shoe Step Tracker reads only one thing from Health Connect: your step count. It never reads other health data and never writes anything to Health Connect.</string>
    <string name="rationale_why">It uses the steps taken while a session is running to show how far each pair of shoes has walked and what each pair costs per step.</string>
    <string name="rationale_stays">Your steps stay on this phone. The app has no internet access, no accounts and no ads, and it doesn\'t share your data with anyone.</string>
    <string name="rationale_control">You can stop step reading at any time in Health Connect. Sessions are still saved, but their steps won\'t be counted.</string>
    <string name="rationale_close">Close</string>
