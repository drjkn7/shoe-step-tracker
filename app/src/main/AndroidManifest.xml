<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SEC-01/SEC-04: no INTERNET or other permissions. NFC (Phase 6) and Health Connect
         READ_STEPS (M1) and READ_DISTANCE (M2) are the only ones allowed; verifyNoInternetPermission
         enforces it. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.NFC" />
    <!-- Tags are a shortcut; the app works without NFC (manual buttons), so it isn't required. -->
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Lets the app see the Health Connect app on Android 13 and lower (not a permission). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:name=".ShoeStepApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShoeStep">
        <!-- SEC-03: exported components are MainActivity and the Health Connect privacy rationale
             (static text, no data). Each is on the release export allowlist in app/build.gradle.kts. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tapping one of our tags opens the app even when it is closed (T06). Tag data is untrusted:
             it only reaches TagFormat.parse. MainActivity accepts tag intents only via these aliases.
             Android 17+ (values-v37): the alias is guarded by DISPATCH_NFC_MESSAGE, so only the NFC
             system service can open it (required for NFC dispatch when targeting SDK 37). -->
        <activity-alias
            android:name=".NfcTagEntry"
            android:enabled="@bool/nfc_entry_protected"
            android:exported="true"
            android:permission="android.permission.DISPATCH_NFC_MESSAGE"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/vnd.io.github.drjkn7.shoestep" />
            </intent-filter>
        </activity-alias>

        <!-- Android 9–16 don't define DISPATCH_NFC_MESSAGE, so their NFC service could not open a guarded
             alias; this unguarded one is enabled there instead (accepted risk: fake tag intents). -->
        <activity-alias
            android:name=".NfcTagEntryLegacy"
            android:enabled="@bool/nfc_entry_legacy"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/vnd.io.github.drjkn7.shoestep" />
            </intent-filter>
        </activity-alias>

        <!-- Health Connect privacy rationale, Android 13 and lower. -->
        <activity
            android:name=".steps.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Health Connect privacy rationale, Android 14+; only the system may open it. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".steps.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
