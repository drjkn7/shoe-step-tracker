# Local machine config (contains your SDK path) - never commit
local.properties

# Signing secrets - never commit (SEC-09, SEC-12)
*.jks
*.keystore
keystore.properties

# Build outputs (app/release/ = Android Studio signed APK, mapping.txt and metadata; keep mapping.txt privately)
app/release/
/build
**/build/
*.apk
*.aab
captures/
.externalNativeBuild
.cxx

# Gradle / Kotlin caches
.gradle/
.kotlin/

# IDE files (machine-specific)
/.idea/
*.iml

# OS files
.DS_Store
Thumbs.db
